lclaude() {
    local model="${LCLAUDE_MODEL:-Qwen/Qwen3.8-27B-FP8}"

    DISABLE_TELEMETRY=1 \
    CLAUDE_CODE_MAX_OUTPUT_TOKENS="${LCLAUDE_MAX_OUTPUT_TOKENS:-8192}" \
    CLAUDE_CODE_EFFORT_LEVEL="${LCLAUDE_EFFORT:-xhigh}" \
    ANTHROPIC_BASE_URL="${LCLAUDE_BASE_URL:-http://localhost:8000}" \
    ANTHROPIC_AUTH_TOKEN="vllm" \
    ANTHROPIC_MODEL="$model" \
    ANTHROPIC_DEFAULT_OPUS_MODEL="$model" \
    ANTHROPIC_DEFAULT_SONNET_MODEL="$model" \
    ANTHROPIC_DEFAULT_HAIKU_MODEL="$model" \
    CLAUDE_CODE_SUBAGENT_MODEL="$model" \
    claude "$@"
}
