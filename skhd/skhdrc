alt - return : osascript -e 'tell application "System Events" to tell process "kitty" to click menu item "New OS Window" of menu 1 of menu bar item "Shell" of menu bar 1' -e 'delay 0.2' -e 'tell application "System Events" to set frontmost of process "kitty" to true' >/dev/null 2>&1 || open -a kitty
# 0x2A = backslash
alt - 0x2A   : osascript -e 'tell application "System Events" to tell process "firefox" to click menu item "New Window" of menu 1 of menu bar item "File" of menu bar 1' -e 'delay 0.2' -e 'tell application "System Events" to set frontmost of process "firefox" to true' >/dev/null 2>&1 || open -a "Firefox Developer Edition"
