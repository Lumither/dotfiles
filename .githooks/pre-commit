#!/usr/bin/env bash

lock="neovim/lazy-lock.json"

staged=$(git diff --cached --name-only)

if echo "$staged" | grep -qx "$lock"; then
    other=$(echo "$staged" | grep -vx "$lock")
    if [ -n "$other" ]; then
        git reset HEAD -- "$lock" >/dev/null 2>&1
        echo "pre-commit: unstaged $lock (stage it alone to commit)"
    fi
fi
