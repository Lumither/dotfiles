// vim: ft=jsonc
[
    // explorer: open file in split right
    {
        "key": "s",
        "command": "explorer.openToSide",
        "when": "explorerViewletVisible && filesExplorerFocus && !inputFocus"
    },
    // explorer: open file in split below
    {
        "key": "shift+s",
        "command": "runCommands",
        "args": {
            "commands": [
                "explorer.openAndPassFocus",
                "workbench.action.moveEditorToBelowGroup"
            ]
        },
        "when": "explorerViewletVisible && filesExplorerFocus && !inputFocus"
    },
    // focus back to editor from terminal/sidebar/panels
    {
        "key": "ctrl+w e",
        "command": "workbench.action.focusActiveEditorGroup",
        "when": "!editorTextFocus"
    },
    // code action / quick fix
    {
        "key": "alt+enter",
        "command": "editor.action.quickFix",
        "when": "editorTextFocus"
    },
    // tabby: accept inline completion
    {
        "key": "cmd+enter",
        "command": "tabby.inlineCompletion.accept",
        "when": "editorTextFocus && tabby.inlineCompletionVisible"
    },
    // tabby: trigger or dismiss inline completion
    {
        "key": "cmd+\\",
        "command": "tabby.inlineCompletion.trigger",
        "when": "editorTextFocus && !tabby.inlineCompletionVisible"
    },
    {
        "key": "cmd+\\",
        "command": "tabby.inlineCompletion.dismiss",
        "when": "editorTextFocus && tabby.inlineCompletionVisible"
    },
    {
        "key": "shift+escape",
        "command": "-workbench.action.terminal.clearSelection",
        "when": "terminalFocusInAny && terminalHasBeenCreated && terminalTextSelected"
    },
    // close active panel with shift+esc
    {
        "key": "shift+escape",
        "command": "workbench.action.closePanel",
        "when": "panelFocus || terminalFocus"
    },
    {
        "key": "shift+escape",
        "command": "workbench.action.closeSidebar",
        "when": "sideBarFocus"
    },
    {
        "key": "shift+escape",
        "command": "workbench.action.closeAuxiliaryBar",
        "when": "auxiliaryBarFocus"
    }
]
