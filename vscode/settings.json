// vim: ft=jsonc
{
    // editor
    "editor.cursorSmoothCaretAnimation": "on",
    "editor.inlineSuggest.showToolbar": "always",
    "files.autoSave": "afterDelay",
    "files.readonlyInclude": {
        "**/.cargo/registry/src/**/*.rs": true,
        "**/lib/rustlib/src/rust/library/**/*.rs": true
    },
    "security.workspace.trust.untrustedFiles": "open",

    // workbench / ui
    "workbench.iconTheme": "vscode-jetbrains-icon-theme-2023-auto",
    "workbench.secondarySideBar.defaultVisibility": "hidden",

    // git
    "git.enableCommitSigning": true,

    // ai / copilot — disabled; using tabby for completions
    "chat.agent.enabled": false,
    "chat.commandCenter.enabled": false,
    "github.copilot.enable": {
        "*": false
    },
    "github.copilot.editor.enableAutoCompletions": false,
    "github.copilot.chat.enabled": false,

    // extensions
    "extensions.experimental.affinity": {
        "asvetliakov.vscode-neovim": 1
    },
    // language-specific overrides
    "[json]": {
        "editor.defaultFormatter": "vscode.json-language-features"
    },
    "[markdown]": {
        "editor.defaultFormatter": "yzhang.markdown-all-in-one"
    },
    "[latex]": {
        "editor.defaultFormatter": "mathematic.vscode-latex"
    },
    "[dockercompose]": {
        "editor.insertSpaces": true,
        "editor.tabSize": 2,
        "editor.autoIndent": "advanced",
        "editor.quickSuggestions": {
            "other": true,
            "comments": false,
            "strings": true
        },
        "editor.defaultFormatter": "redhat.vscode-yaml"
    },
    "[github-actions-workflow]": {
        "editor.defaultFormatter": "redhat.vscode-yaml"
    },

    // language tooling
    "C_Cpp.intelliSenseEngine": "disabled",
    "cmake.pinnedCommands": [
        "workbench.action.tasks.configureTaskRunner",
        "workbench.action.tasks.runTask"
    ],
    "docker.extension.enableComposeLanguageServer": false,
    "julia.symbolCacheDownload": true,
    "makefile.configureOnOpen": true,
    "terminal.integrated.commandsToSkipShell": [
        "language-julia.interrupt",
        "workbench.action.closePanel"
    ],
    "python.analysis.typeCheckingMode": "basic",
    "rust-analyzer.check.command": "clippy",
    // "rust-analyzer.check.extraArgs": ["--", "-W", "clippy::pedantic"],
    "tabby.settings.advanced": {
        "inlineCompletion.disabledLanguages": [
            "markdown"
        ]
    },
    "json.schemaDownload.trustedDomains": {
        "https://developer.microsoft.com/json-schemas/": true,
        "https://json-schema.org/": true,
        "https://json.schemastore.org/": true,
        "https://raw.githubusercontent.com/DavidAnson/markdownlint/v0.40.0/schema/markdownlint-config-schema.json": true,
        "https://raw.githubusercontent.com/devcontainers/spec/": true,
        "https://raw.githubusercontent.com/microsoft/vscode/": true,
        "https://schemastore.azurewebsites.net/": true,
        "https://www.schemastore.org/": true
    },
    "[typescript]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "chat.disableAIFeatures": true
}
